{
  "name": "@cognigy/click-to-call-widget",
  "version": "0.0.1",
  "type": "module",
  "description": "A click-to-call WebRTC widget for Cognigy AI voicebots",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cognigy/click-to-call-widget.git"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc -b && vite build",
    "build-dev": "tsc -b && vite build --mode development",
    "preview": "vite preview",
    "lint": "biome lint",
    "lint:fix": "biome format src --write",
    "test": "vitest --run"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "events": "^3.3.0",
    "jssip": "^3.10.1",
    "preact": "^10.27.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@preact/preset-vite": "^2.10.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^25.3.0",
    "canvas": "^3.1.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.3",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-bundle-analyzer": "^0.18.1",
    "vite-plugin-compression2": "^2.5.0",
    "vitest": "^3.0.9"
  },
  "msw": {
    "workerDirectory": [
      "."
    ]
  }
}
